<Application x:Class="AppManager2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:con="clr-namespace:AppManager2.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AppManager2;component/Resources/Style/Buttons.xaml"/>
                <ResourceDictionary Source="/AppManager2;component/Resources/Style/TextBoxPlaceHolder.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 界面字体/颜色主题默认值（启动时ThemeUtils.Init按System.ini [set]覆盖，
                 各控件DynamicResource引用，保存设置后即时生效） -->
            <FontFamily x:Key="AppFontFamily">微软雅黑</FontFamily>
            <sys:Double x:Key="AppFontSize">12</sys:Double>
            <SolidColorBrush x:Key="AppFontColor" Color="Black"/>
            <FontFamily x:Key="BtnFontFamily">微软雅黑</FontFamily>
            <sys:Double x:Key="BtnFontSize">14</sys:Double>
            <FontFamily x:Key="TreeFontFamily">微软雅黑</FontFamily>
            <sys:Double x:Key="TreeFontSize">16</sys:Double>
            <SolidColorBrush x:Key="TreeFontColor" Color="Black"/>
            <SolidColorBrush x:Key="LogFontColor" Color="White"/>
            <SolidColorBrush x:Key="LogBgColor" Color="Black"/>
            <sys:Double x:Key="LogFontSize">14</sys:Double>
            <FontFamily x:Key="LogFontFamily">Consolas</FontFamily>

            <!-- 转换器资源 -->
            <con:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <con:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <con:RunStatToColorConverter x:Key="RunStatToColorConverter" />
            <con:RunStatToTextConverter x:Key="RunStatToTextConverter" />
            <con:SplitRatioToGridLengthConverter x:Key="SplitRatioConverter"/>
            <con:AppTypeToColorConverter x:Key="AppTypeToColorConverter"/>
            <con:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <con:HalfConverter x:Key="HalfConverter"/>
            <con:StringEqualityConverter x:Key="StringEqualityConverter"/>
            <con:StringToFontFamilyConverter x:Key="StringToFontFamilyConverter"/>
            <con:StringToFontSizeConverter x:Key="StringToFontSizeConverter"/>
            <con:StringToBrushConverter x:Key="StringToBrushConverter"/>

            <!-- 表单标题样式 -->
            <Style x:Key="FormLabel_Style" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="5 5 5 0" />
            </Style>
            <!-- 表单值样式 -->
            <Style x:Key="FormValue_Style" TargetType="Control">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="5 5 5 0" />
                <Setter Property="Padding" Value="5 0"/>
                <Setter Property="Height" Value="28"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
