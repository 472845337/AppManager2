<Window x:Class="AppManager2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppManager2"
        xmlns:views="clr-namespace:AppManager2.Views"
        xmlns:vm="clr-namespace:AppManager2.ViewModels"
        xmlns:behaviors="clr-namespace:AppManager2.Behaviors"
        xmlns:controls="clr-namespace:AppManager2.Controls"
        mc:Ignorable="d"
        Title="应用管理" Height="500" Width="600"
        Icon="pack://application:,,,/AppManager2;component/Resources/icon/Window/main.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Foreground="{DynamicResource AppFontColor}">
    <Window.Resources>
        <!-- 基于App隐式TabItem样式（含全局字色）派生，仅补Padding；否则本样式遮蔽App级样式导致Tab头字色失效 -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="5 5"/>
        </Style>
        <!-- 溢出下拉TabControl模板（参考IntelliJ的Tab设计）：头部=下拉按钮+自绘分行面板，
             放不下的Tab进下拉列表；选中项变化由控件重新布局换回可见区 -->
        <Style TargetType="controls:OverflowTabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:OverflowTabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <!-- 选项卡选项按钮（参考VS2022）：菜单含多行显示开关，菜单在弹出的Popup中
                                     DataContext断链，改用PlacementTarget回取 -->
                                <ToggleButton VerticalAlignment="Top" x:Name="PART_TabMenuButton" DockPanel.Dock="Right" Width="20" Height="20"
                                              Margin="1 2 0 0" Content="≡" Padding="0" Focusable="False"
                                              ToolTip="选项卡选项">
                                    <ToggleButton.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <!-- Tab行数三选一（与设置-应用监控-Tab行数一致）：
                                                 勾选态经StringEqualityConverter绑定SelectedRunTabRows，命令切换后互斥刷新 -->
                                            <MenuItem Header="单行" IsCheckable="True"
                                                      IsChecked="{Binding SelectedRunTabRows, Converter={StaticResource StringEqualityConverter}, ConverterParameter=1, Mode=OneWay}"
                                                      Command="{Binding SetRunTabRowsCommand}" CommandParameter="1"/>
                                            <MenuItem Header="双行" IsCheckable="True"
                                                      IsChecked="{Binding SelectedRunTabRows, Converter={StaticResource StringEqualityConverter}, ConverterParameter=2, Mode=OneWay}"
                                                      Command="{Binding SetRunTabRowsCommand}" CommandParameter="2"/>
                                            <MenuItem Header="自适应" IsCheckable="True"
                                                      IsChecked="{Binding SelectedRunTabRows, Converter={StaticResource StringEqualityConverter}, ConverterParameter=0, Mode=OneWay}"
                                                      Command="{Binding SetRunTabRowsCommand}" CommandParameter="0"/>
                                        </ContextMenu>
                                    </ToggleButton.ContextMenu>
                                </ToggleButton>
                                <!-- 右侧下拉箭头：单/双行模式常显（多行模式由控件隐藏），全部放得下时下拉里只是没有隐藏项 -->
                                <ToggleButton VerticalAlignment="Top" x:Name="PART_OverflowButton" DockPanel.Dock="Right" Width="20" Height="20"
                                              Margin="1 2 0 0" Content="▾" Padding="0"
                                              ToolTip="更多运行Tab"
                                              Focusable="False"/>
                                <Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#999" BorderThickness="1" MinWidth="120" MaxHeight="260">
                                        <ListBox x:Name="PART_OverflowList" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" Margin="6 3">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Foreground" Value="Green"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                                <!-- IsItemsHost：TabItem容器生成到此面板 -->
                                <controls:OverflowTabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                                           MaxRows="{TemplateBinding MaxRows}"/>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 颜色下拉选项模板：色块+颜色名（软件设置的字体/日志颜色选择） -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="14" Height="14" Margin="0,0,5,0" Stroke="#999" Fill="{Binding Brush}"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="0 5"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Margin" Value="5 2"/>
        </Style>
        <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- 应用节点右键菜单（对应 Init2Tree 中应用节点的菜单） -->
        <ContextMenu x:Key="AppNodeContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="查看" Command="{Binding DetailCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/detail.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="警报(开)" Command="{Binding WarnSwitchCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/warn-on.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarn}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="警报(关)" Command="{Binding WarnSwitchCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/warn-off.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="启动" Command="{Binding StartCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/start.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="停止" Command="{Binding StopCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/stop.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <!-- 重置状态：程序在软件外异常退出时监控持续判失败（橙色+刷app is fail），
                 仅Fail状态显示，标识回初始未运行（白色）；若程序实际在运行，下轮监控自动恢复 -->
            <MenuItem Header="重置状态" Command="{Binding ResetRunStatCommand}" CommandParameter="{Binding}"
                      ToolTip="程序异常退出后将状态标识为初始未运行">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/fresh.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunStat}" Value="-1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="编辑" Command="{Binding EditCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/edit.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="删除" Command="{Binding DeleteCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/remove.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="定位文件" Command="{Binding LocateFileCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/AppRightMenu/File.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- 组节点右键菜单（对应 Init2Tree 中组节点的菜单） -->
        <ContextMenu x:Key="GroupNodeContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="启动" Command="{Binding StartCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/start.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="停止" Command="{Binding StopCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/stop.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="警报(开)" Command="{Binding WarnOnCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/warn-on.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="警报(关)" Command="{Binding WarnOffCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/warn-off.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="删除" Command="{Binding DeleteCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/remove.ico" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="应用管理" Width="80">
                <Grid x:Name="AppTabGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TreeColumn" MinWidth="100" Width="{Binding TreeSplitRatio, Converter={StaticResource SplitRatioConverter}, Mode=TwoWay}"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition MinWidth="60" Width="{Binding RunSplitRatio, Converter={StaticResource SplitRatioConverter}, Mode=TwoWay}"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TreeView Grid.Row="0" x:Name="AppTreeView" ItemsSource="{Binding AppTree}" DockPanel.Dock="Top"
                                      Background="Transparent"
                                      FontFamily="{DynamicResource TreeFontFamily}"
                                      FontSize="{DynamicResource TreeFontSize}"
                                      Foreground="{DynamicResource TreeFontColor}"
                                      SelectedItemChanged="TreeView_SelectedItemChanged"
                                      PreviewMouseLeftButtonUp="AppTreeView_PreviewMouseLeftButtonUp"
                                      GotKeyboardFocus="AppTreeView_KeyboardFocusChanged"
                                      LostKeyboardFocus="AppTreeView_KeyboardFocusChanged"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="AppTreeView_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="AppTreeView_PreviewMouseMove"
                                      DragOver="AppTreeView_DragOver"
                                      Drop="AppTreeView_Drop"
                                      VirtualizingStackPanel.IsVirtualizing="False">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <!-- 节点名不设字号，随应用树的TreeFontSize设置 -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Remark}"/>
                                        <TextBlock Text="{Binding RunStatText}" Foreground="Gray" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <!-- 展开/收缩状态存于节点模型（双向），新增项目到收缩组时由VM定向展开该组 -->
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Background" Value="{Binding BackgroundBrush}"/>
                                    <!-- TreeViewItem主题样式自带的Foreground setter优先级高于继承值，
                                         不显式设置时树的字色设置不生效；选中变白的模板触发器优先级更高，不受影响 -->
                                    <Setter Property="Foreground" Value="{DynamicResource TreeFontColor}"/>
                                    <!-- 自定义模板：Bd根Border横向铺满整行，状态背景色覆盖整行，点击行内任意位置（含展开符区域）均可选中 -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid Background="Transparent">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press" Focusable="False"
                                                                              Foreground="#666666"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Width="16" Height="16" Background="Transparent" HorizontalAlignment="Center">
                                                                                <Path x:Name="ExpandPath" Data="M 0 0 L 6 6 L 0 12 Z" Fill="{TemplateBinding Foreground}"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          RenderTransformOrigin="0.5,0.5">
                                                                                </Path>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                            </Grid>
                                                            <!-- 悬停提示遮罩：半透明蓝色叠在运行状态色之上，不拦截鼠标 -->
                                                            <Border x:Name="HoverOverlay" Background="#334285F4" Visibility="Collapsed"
                                                                        IsHitTestVisible="False"/>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsPresenter x:Name="ItemsHost"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                    </Trigger>
                                                    <!-- 组内项目：仅头部内容右移一层标识归属，整行背景（状态色/选中/悬停）保持铺满不缺角 -->
                                                    <DataTrigger Binding="{Binding IsGroupMember}" Value="True">
                                                        <Setter TargetName="PART_Header" Property="Margin" Value="16,0,0,0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <!-- 选中行深蓝背景下三角符同步变白（随文字颜色），否则灰色看不清 -->
                                                        <Setter TargetName="Expander" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <!-- 悬停不覆盖背景：保留运行状态色，仅叠加半透明高亮遮罩（HoverOverlay）提示 -->
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- 拦截选中/聚焦的自动滚入：长项目名行不再把水平滚动条拉到最右（垂直跟随保留，处理在code-behind） -->
                                    <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Flag}" Value="group">
                                            <Setter Property="ContextMenu" Value="{StaticResource GroupNodeContextMenu}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Flag}" Value="child">
                                            <Setter Property="ContextMenu" Value="{StaticResource AppNodeContextMenu}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="添加(_A)" Command="{Binding AddAppCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/add.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="全部启动(_S)" Command="{Binding AllStartCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/start.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="全部停止(_T)" Command="{Binding AllStopCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/stop.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="展开所有(_E)" Command="{Binding ExpandAllCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/expand.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="收缩所有(_C)" Command="{Binding CollapseAllCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/menu-icon/collapse.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="导出(_O)" Command="{Binding ExportConfigCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/AppForm/Export.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="导入(_I)" Command="{Binding ImportConfigCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/AppForm/Import.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="清空(_L)" Command="{Binding ClearAllCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/Base/Clear.ico" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <StackPanel Grid.Row="1" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn_Pri}" Content="添加" Command="{Binding AddAppCommand}" Width="60" Height="36"/>
                            <Button Style="{StaticResource Btn_Danger}" Content="清空" Command="{Binding ClearAllCommand}" Width="60" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#ddd"/>

                    <!-- 运行Tab：标题按项目运行顺序展示；支持拖拽标题调整顺序（仅当前会话的显示顺序，不持久化）；
                         MaxRows为表头行数（设置-应用监控-Tab行数）：1单行/2双行/0不限，放不下的进右侧下拉箭头 -->
                    <controls:OverflowTabControl Grid.Column="2" x:Name="RunTabControl" AllowDrop="True" MaxRows="{Binding RunTabRows}"
                                    ItemsSource="{Binding RunningApps}" SelectedIndex="{Binding SelectedTabIndex}"
                                    PreviewMouseLeftButtonDown="RunTabControl_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="RunTabControl_PreviewMouseMove"
                                    DragOver="RunTabControl_DragOver"
                                    Drop="RunTabControl_Drop"
                                    SelectionChanged="OnTabControlSelectionChanged" Margin="2">
                        <TabControl.ContextMenu>
                            <!-- 运行面板右键：关闭已停止的窗口（对应老项目AppRunTabControl右键菜单） -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="关闭所有已停止" Command="{Binding CloseStoppedTabsCommand}"/>
                            </ContextMenu>
                        </TabControl.ContextMenu>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="●" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="ToolTip" Value="已停止"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Setter Property="ToolTip" Value="运行中"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource Btn_Danger}" Grid.Column="2" Content="×" Width="22" Height="20" Margin="2 0 0 0" Padding="0"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- 底部输入框：回车向进程stdin发送输入（对应老项目CreateAppRunTabPage的输入TextBox） -->
                                    <TextBox DockPanel.Dock="Bottom" Height="25" Margin="0,4,0,0" Padding="2"
                                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                 Template="{StaticResource PlaceHolder}" Tag="输入内容后回车发送到进程">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.SendInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <!-- 运行日志（对应老项目RichTextBox，黑底白字+ANSI彩色+行数裁剪+自动滚动）：
                                         RichTextBox按行显示彩色Run，日志文档由Tab模型持有（切Tab换挂Document）；
                                         换行按项目配置：系统(取设置-应用监控)/自动WrapWithOverflow/不换行NoWrap；
                                         Ctrl+滚轮调整字体大小（8~40，超限静默不变，不持久化），
                                         字号绑定Tab模型：TabControl切换Tab复用元素树，存控件本地值会串到其他项目 -->
                                    <RichTextBox IsReadOnly="True" Padding="0"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontSize="{Binding LogFontSize}"
                                                 FontFamily="{DynamicResource LogFontFamily}"
                                                 Background="{DynamicResource LogBgColor}" Foreground="{DynamicResource LogFontColor}" BorderThickness="0"
                                                 PreviewMouseWheel="RunLogTextBox_PreviewMouseWheel"
                                                 DataContextChanged="RunLogRichTextBox_DataContextChanged"
                                                 ScrollViewer.ScrollChanged="RunLogRichTextBox_ScrollChanged"
                                                 behaviors:RichTextBoxHelper.BoundDocument="{Binding LogDocument}">
                                        <RichTextBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="复制" Click="RunLogCopy_Click"/>
                                                <MenuItem Header="清空" Click="RunLogClear_Click"/>
                                                <Separator/>
                                                <!-- 切换本项目的日志换行模式（勾选标记当前模式，立即入库） -->
                                                <MenuItem Header="日志换行">
                                                    <MenuItem Header="系统配置" Tag="system" Click="RunLogWrapMenu_Click"
                                                              IsChecked="{Binding LogWrap, Converter={StaticResource StringEqualityConverter}, ConverterParameter=system, Mode=OneWay}"/>
                                                    <MenuItem Header="自动换行" Tag="auto" Click="RunLogWrapMenu_Click"
                                                              IsChecked="{Binding LogWrap, Converter={StaticResource StringEqualityConverter}, ConverterParameter=auto, Mode=OneWay}"/>
                                                    <MenuItem Header="不换行" Tag="none" Click="RunLogWrapMenu_Click"
                                                              IsChecked="{Binding LogWrap, Converter={StaticResource StringEqualityConverter}, ConverterParameter=none, Mode=OneWay}"/>
                                                </MenuItem>
                                            </ContextMenu>
                                        </RichTextBox.ContextMenu>
                                    </RichTextBox>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </controls:OverflowTabControl>
                </Grid>
            </TabItem>

            <TabItem Header="设置" Width="80">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl x:Name="SettingTabControl" SelectedIndex="{Binding SettingTabControlSelectedIndex, Mode=TwoWay}" Grid.Row="0" TabStripPlacement="Left">
                        <TabItem Header="应用设置">
                            <!-- 对应老项目SetPage：应用设置/环境配置/自启动/监听/关闭时
布局对应老版锚定方式：上部两个GroupBox随宽度拉伸，自启动框四边拉伸（占剩余空间），监听/关闭时固定右上 -->
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="120"/>
                                </Grid.RowDefinitions>

                                <!-- 监听设置：心跳字符/通知+预警地址/机器名 -->
                                <GroupBox Grid.Row="0" Header="预警设置">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="心跳字符:" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1" Text="{Binding HeartBeatMsg, UpdateSourceTrigger=PropertyChanged}"
                    Template="{StaticResource PlaceHolder}" Tag="心跳接口返回的预期内容，默认success"/>

                                        <CheckBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="0" Content="通  知:" IsChecked="{Binding IsWarnEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1" Text="{Binding WarnUrl, UpdateSourceTrigger=PropertyChanged}"
                    Template="{StaticResource PlaceHolder}" Tag="预警地址（企业微信机器人地址）"/>

                                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="机  器  名:" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="1" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                    Template="{StaticResource PlaceHolder}" Tag="预警时展示的服务器名，便于区分机器，留空使用本机IP"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 环境配置：Jdk/配置(dev|test|prod)/日志 -->
                                <GroupBox Grid.Row="1" Header="环境配置">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="J D K:" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding JdkPath, UpdateSourceTrigger=PropertyChanged}"
                    Template="{StaticResource PlaceHolder}" Tag="JDK根目录，生成启动脚本使用"/>
                                        <Button Style="{StaticResource Btn_Info}" Grid.Row="0" Grid.Column="4" Content="..." Command="{Binding BrowseJdkCommand}"
                   ToolTip="选择JDK目录"/>

                                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="配  置:" VerticalAlignment="Center"/>
                                        <ComboBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                     ItemsSource="{Binding ProfilesOptions}" SelectedItem="{Binding SelectedProfile}"
                     ToolTip="启动环境，生成java启动脚本的spring.profiles.active"/>
                                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="2" Text="日  志:" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="3" Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"
                    Template="{StaticResource PlaceHolder}" Tag="运行日志输出目录"/>
                                        <Button Style="{StaticResource Btn_Info}" Grid.Row="1" Grid.Column="4" Content="..." Command="{Binding BrowseLogCommand}"
                   ToolTip="选择日志目录"/>
                                    </Grid>
                                </GroupBox>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 自启动：全选+项目自启动项（与项目编辑中的自启动联动），随窗口四边拉伸 -->
                                    <GroupBox Grid.Column="0">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="自启动"/>
                                                <CheckBox Style="{StaticResource FormValue_Style}" Content="全选" IsChecked="{Binding AutoRunAll}"/>
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <!-- 自启动项由code-behind逐个添加（监听AutoRunItems集合变化），
                        WrapPanel超出宽度自动换行（横向滚动必须保持禁用，否则内容宽度不受限不会换行） -->
                                            <WrapPanel x:Name="AutoRunPanel" Margin="5"/>
                                        </ScrollViewer>
                                    </GroupBox>
                                    <!-- 监听：端口/心跳判定的超时时间与频次 -->
                                    <GroupBox Grid.Column="1" Header="应用监控" Padding="5" Margin="10,5,0,10">
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel_Style}" Text="超      时/s："/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormValue_Style}" Text="{Binding MonitorTimeoutText, UpdateSourceTrigger=PropertyChanged}"
Template="{StaticResource PlaceHolder}" Tag="15" MinWidth="50" Width="Auto"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FormLabel_Style}" Text="频      次/s："/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource FormValue_Style}" Text="{Binding MonitorIntervalText, UpdateSourceTrigger=PropertyChanged}"
Template="{StaticResource PlaceHolder}" Tag="5" MinWidth="50" Width="Auto"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel_Style}" Text="日 志 换 行："/>
                                            <!-- 系统级换行配置（[set] log_wrap，默认不换行）：项目换行为“系统”时按此生效 -->
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FormValue_Style}" MinWidth="110" Width="Auto"
ItemsSource="{Binding LogWrapOptions}" DisplayMemberPath="Text" SelectedValuePath="Code"
SelectedValue="{Binding SelectedLogWrap}"
ToolTip="运行日志默认换行方式，项目换行为“系统”时使用"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel_Style}" Text="项目选项卡："/>
                                            <!-- 运行Tab表头行数（[set] run_tab_rows）：单行/双行/自适应，
 单行/双行放不下的Tab收进右侧下拉箭头（参考IntelliJ） -->
                                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FormValue_Style}" MinWidth="80" Width="Auto"
ItemsSource="{Binding RunTabRowsOptions}" DisplayMemberPath="Text" SelectedValuePath="Code"
SelectedValue="{Binding SelectedRunTabRows}"
ToolTip="运行Tab表头显示行数：单行/双行时放不下的Tab收进右侧下拉箭头"/>
                                        </Grid>
                                    </GroupBox>

                                </Grid>

                            </Grid>
                        </TabItem>
                        <TabItem Header="软件设置">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel Margin="10">
                                    <!-- 界面字体：全局所有控件 + 按钮（保存于System.ini [set]，保存后即时生效） -->
                                    <GroupBox Header="界面字体" Padding="8" Margin="0,0,8,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="全局字体:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="150" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontOptions}"
                                                      SelectedItem="{Binding GlobalFontFamily}"
                                                      ToolTip="软件所有控件的字体类型">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       号:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="60" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontSizeOptions}"
                                                      SelectedItem="{Binding GlobalFontSizeText}"/>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       色:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="100" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.ColorOptions}"
                                                      SelectedValuePath="Name" SelectedValue="{Binding GlobalFontColor}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}"
                                                      ToolTip="软件所有控件的字体颜色"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="按钮字体:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="150" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontOptions}"
                                                      SelectedItem="{Binding BtnFontFamily}"
                                                      ToolTip="软件中所有按钮的字体类型">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       号:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="60" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontSizeOptions}"
                                                      SelectedItem="{Binding BtnFontSizeText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 应用树：应用管理Tab左侧项目树 -->
                                    <GroupBox Header="应用树" Padding="8" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       体:"/>
                                            <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="150" Width="Auto"
                                                  ItemsSource="{x:Static vm:MainWindowViewModel.FontOptions}"
                                                  SelectedItem="{Binding TreeFontFamily}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       号:"/>
                                            <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="60" Width="Auto"
                                                  ItemsSource="{x:Static vm:MainWindowViewModel.FontSizeOptions}"
                                                  SelectedItem="{Binding TreeFontSizeText}"/>
                                            <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       色:"/>
                                            <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="100" Width="Auto"
                                                  ItemsSource="{x:Static vm:MainWindowViewModel.ColorOptions}"
                                                  SelectedValuePath="Name" SelectedValue="{Binding TreeFontColor}"
                                                  ItemTemplate="{StaticResource ColorItemTemplate}"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 日志：应用监听运行日志与工具Tab的HTTP响应日志；
                                     字号为启动初始值，Ctrl+滚轮在其基础上临时调整 -->
                                    <GroupBox Header="日志" Padding="8" Margin="0,0,8,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       体:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="150" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontOptions}"
                                                      SelectedItem="{Binding LogFontFamily}"
                                                      ToolTip="运行日志与HTTP响应日志的字体类型">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       号:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="60" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.FontSizeOptions}"
                                                      SelectedItem="{Binding LogFontSizeText}"
                                                      ToolTip="启动时的初始字号，运行中Ctrl+滚轮临时缩放"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="字       色:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="100" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.ColorOptions}"
                                                      SelectedValuePath="Name" SelectedValue="{Binding LogFontColor}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}"
                                                      ToolTip="应用监听日志与HTTP响应日志的字体颜色"/>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="背  景  色:"/>
                                                <ComboBox Style="{StaticResource FormValue_Style}" MinWidth="100" Width="Auto"
                                                      ItemsSource="{x:Static vm:MainWindowViewModel.ColorOptions}"
                                                      SelectedValuePath="Name" SelectedValue="{Binding LogBgColor}"
                                                      ItemTemplate="{StaticResource ColorItemTemplate}"
                                                      ToolTip="应用监听日志与HTTP响应日志的背景色"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 预览：随上面各下拉当前值即时刷新（保存前即可看到效果） -->
                                    <GroupBox Header="预览" Padding="8" Margin="0,0,8,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="全       局:" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="应用管理 ABCabc123" VerticalAlignment="Center"
                                                       FontFamily="{Binding GlobalFontFamily, Converter={StaticResource StringToFontFamilyConverter}}"
                                                       FontSize="{Binding GlobalFontSizeText, Converter={StaticResource StringToFontSizeConverter}, ConverterParameter=12}"
                                                       Foreground="{Binding GlobalFontColor, Converter={StaticResource StringToBrushConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="按       钮:" VerticalAlignment="Center"/>
                                                <!-- 本地FontFamily/FontSize覆盖按钮样式的DynamicResource，预览未保存的值 -->
                                                <Button Content="按钮字体预览" Style="{StaticResource Btn_Pri}"
                                                    FontFamily="{Binding BtnFontFamily, Converter={StaticResource StringToFontFamilyConverter}}"
                                                    FontSize="{Binding BtnFontSizeText, Converter={StaticResource StringToFontSizeConverter}, ConverterParameter=14}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="应  用  树:" VerticalAlignment="Center"/>
                                                <TreeView Margin="2 5" Width="200" BorderThickness="1" BorderBrush="#ddd" Background="White"
                                                      FontFamily="{Binding TreeFontFamily, Converter={StaticResource StringToFontFamilyConverter}}"
                                                      FontSize="{Binding TreeFontSizeText, Converter={StaticResource StringToFontSizeConverter}, ConverterParameter=16}"
                                                      Foreground="{Binding TreeFontColor, Converter={StaticResource StringToBrushConverter}}">
                                                    <TreeView.ItemContainerStyle>
                                                        <!-- 同主界面应用树：覆盖TreeViewItem主题样式的Foreground，否则预览字色不生效 -->
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="Foreground" Value="{Binding TreeFontColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                    <TreeViewItem Header="示例分组" IsExpanded="True">
                                                        <TreeViewItem Header="示例应用"/>
                                                    </TreeViewItem>
                                                </TreeView>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FormLabel_Style}" Text="日       志:" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource FormValue_Style}" Padding="5" Height="Auto" Width="300" IsReadOnly="True"
                                                     FontFamily="{Binding LogFontFamily, Converter={StaticResource StringToFontFamilyConverter}}"
                                                     FontSize="{Binding LogFontSizeText, Converter={StaticResource StringToFontSizeConverter}, ConverterParameter=14}"
                                                     Text="INFO : 应用启动成功"
                                                     Foreground="{Binding LogFontColor, Converter={StaticResource StringToBrushConverter}}"
                                                     Background="{Binding LogBgColor, Converter={StaticResource StringToBrushConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <!-- 关闭时：退出/最小化 -->
                                    <GroupBox Header="关闭时" Padding="10" Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="退出" GroupName="ClosedType" IsChecked="{Binding IsClosedExit}" Margin="0,0,20,0"/>
                                            <RadioButton Content="最小化" GroupName="ClosedType" IsChecked="{Binding IsClosedMin}"/>
                                        </StackPanel>
                                    </GroupBox>


                                </WrapPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 恢复默认：重置软件设置各项为初始默认值（点击后先确认） -->
                        <Button Margin="2 2" Style="{StaticResource Btn_Warn}" Content="恢复默认" Command="{Binding ResetSoftwareSettingsCommand}" Height="36" VerticalAlignment="Bottom" ToolTip="恢复软件设置（关闭方式/字体/颜色）为默认值"/>
                        <Button Margin="2 2" Grid.Row="1" Style="{StaticResource Btn_Pri}" Content="应用" Command="{Binding ApplySettingsCommand}" Height="36" HorizontalAlignment="Right"
                                ToolTip="把当前页面配置生效到软件（字体/颜色/监控等），落盘在关闭软件时统一处理"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="工具" Width="80">
                <TabControl TabStripPlacement="Left">
                    <TabItem Header="PostDog">
                        <views:PostDogPageView/>
                    </TabItem>
                    <TabItem Header="WebBrowser">
                        <views:WebBrowserPageView/>
                    </TabItem>
                </TabControl>

            </TabItem>
            <TabItem Header="帮助" Width="80" Loaded="HelpTab_Loaded">
                <!-- 对应老项目HelpPage：读取doc\help.rtf只读显示（字体随全局设置） -->
                <RichTextBox x:Name="HelpRichTextBox" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Padding="10"/>
            </TabItem>
        </TabControl>

        <!-- 状态栏：左=瞬时提示（对应OperateMessageStatusLabel），右=IP/作者（字体随全局设置） -->
        <StatusBar Grid.Row="1">
            <StatusBarItem HorizontalAlignment="Left" Margin="10 0 0 0">
                <TextBlock Text="{Binding OperateMessage}" Foreground="{Binding OperateMessageBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="0 0 10 0">
                <TextBlock>
                    <Run Text="{Binding IpInfo}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding AuthorInfo}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

