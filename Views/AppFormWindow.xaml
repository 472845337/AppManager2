<Window x:Class="AppManager2.Views.AppFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppManager2.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="Auto" MinWidth="450" Width="500"
        Icon="pack://application:,,,/AppManager2;component/Resources/icon/Window/appform.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.DataContext>
        <vm:AppFormViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Padding="5" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 基本信息区域 -->
                <GroupBox Grid.Row="0" Header="基本信息">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 类型 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="类 型:"/>
                        <ComboBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AppTypes}"
                          SelectedItem="{Binding AppType}"
                          IsEnabled="{Binding IsEditMode}"
                          />
                        <!-- 分组 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="2" Text="分 组:"/>
                        <ComboBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="3"
      ItemsSource="{Binding Groups}"
      Text="{Binding Group}"
      IsEditable="True"
      IsEnabled="{Binding IsEditMode}"
      />
                        <!-- 名称 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="名 称:" Foreground="#DC3545">
                        </TextBlock>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding AppTitle, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditMode}"
                          Template="{StaticResource PlaceHolder}" Tag="项目名，最好带上端口"/>



                    </Grid>
                </GroupBox>

                <!-- 路径配置区域 -->
                <GroupBox Grid.Row="1" Header="路径配置">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- 应用路径 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="路 径:" Foreground="#DC3545">
                        </TextBlock>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1"
                         Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}" Template="{StaticResource PlaceHolder}" Tag="jar、bat或exe的文件路径"/>

                        <Button Style="{StaticResource Btn_Info}" Grid.Row="0" Grid.Column="2" Content="..."
                        Command="{Binding BrowseAppPathCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        />

                        <!-- 停止脚本 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="终 止:" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="stop">
                                    <Binding Path="AppType"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1"
                         Text="{Binding StopPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Template="{StaticResource PlaceHolder}" Tag="bat类型用于终止的脚本路径">

                        </TextBox>
                        <Button Style="{StaticResource Btn_Info}" Grid.Row="1" Grid.Column="2" Content="..."
                        Command="{Binding BrowseStopPathCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        />

                        <!-- JDK路径 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="J D K:" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="1"
                         Text="{Binding JdkPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Template="{StaticResource PlaceHolder}" Tag="jar包自定义的JDK路径"/>

                        <Button Style="{StaticResource Btn_Info}" Grid.Row="2" Grid.Column="2" Content="..."
                        Command="{Binding BrowseJdkPathCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        />
                    </Grid>
                </GroupBox>

                <!-- 运行配置区域 -->
                <GroupBox Grid.Row="2" Header="运行配置">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 端口 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="端 口:" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="port">
                                    <Binding Path="AppType"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Template="{StaticResource PlaceHolder}" Tag="java项目启动端口">
                        </TextBox>

                        <!-- 心跳地址 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="心 跳:" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="heartbeat">
                                    <Binding Path="AppType"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding HeartBeatUrl, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Template="{StaticResource PlaceHolder}" Tag="监控心跳地址">
                        </TextBox>

                        <!-- Actuator -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="驱 动:" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding ActuatorUrl, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Template="{StaticResource PlaceHolder}" Tag="spring autor">

                        </TextBox>
                    </Grid>
                </GroupBox>

                <!-- 参数配置区域 -->
                <GroupBox Grid.Row="3" Header="参数配置">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="40"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- JVM参数 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="配 置:" VerticalAlignment="Top"/>
                        <Button Style="{StaticResource Btn_Pri}" Grid.Row="0" Grid.Column="1" Content="常用"
                        Command="{Binding DefaultJvmCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        VerticalAlignment="Top" FontSize="10"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="2"
                         Text="{Binding JvmParams, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Height="Auto" TextWrapping="Wrap" AcceptsReturn="True"
                         Template="{StaticResource PlaceHolder}" Tag="java启动项内存等配置">
                        </TextBox>

                        <GridSplitter Margin="2 2 2 0" Grid.Row="1" Grid.Column="2" Height="5" HorizontalAlignment="Stretch" Background="#ddd"/>
                        <!-- 环境参数 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="参 数:" VerticalAlignment="Top"/>
                        <Button Style="{StaticResource Btn_Pri}" Grid.Row="2" Grid.Column="1" Content="常用"
                        Command="{Binding DefaultEnvCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        VerticalAlignment="Top" FontSize="10"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="2"
                         Text="{Binding EnvParams, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsDetailMode}"
                         Height="Auto" TextWrapping="Wrap" AcceptsReturn="True"
                         Template="{StaticResource PlaceHolder}" Tag="java启动参数日志路径环境等"></TextBox>

                        <GridSplitter Margin="2 2 2 0" Grid.Row="3" Grid.Column="2" Height="5" HorizontalAlignment="Stretch" Background="#ddd"/>
                        <!-- 扩展脚本 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="4" Grid.Column="0" Text="扩 展:" VerticalAlignment="Top"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
 Text="{Binding ExtScript, UpdateSourceTrigger=PropertyChanged}"
 IsReadOnly="{Binding IsDetailMode}"
 Height="Auto" TextWrapping="Wrap" AcceptsReturn="True"
 Template="{StaticResource PlaceHolder}" Tag="java启动项脚本之前的配置">
                        </TextBox>


                    </Grid>
                </GroupBox>

                <!-- 其他配置区域 -->
                <GroupBox Grid.Row="4" Header="其他配置">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 其他配置选项 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource FormValue_Style}" Content="警报" IsChecked="{Binding IsWarn}" IsEnabled="{Binding IsEditMode}"/>
                            <CheckBox Style="{StaticResource FormValue_Style}" Content="自动启动" IsChecked="{Binding AutoRun}" IsEnabled="{Binding IsEditMode}"/>
                            <CheckBox Style="{StaticResource FormValue_Style}" Content="控制面板日志" IsChecked="{Binding IsPrintLog}" IsEnabled="{Binding IsEditMode}"/>
                            <!-- 运行日志换行：系统/自动/不换行 -->
                            <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Column="0" Grid.Row="2" Text="换行" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource FormValue_Style}" Grid.Column="1" Grid.Row="2" Width="90" HorizontalAlignment="Left"
          ItemsSource="{Binding LogWrapOptions}" DisplayMemberPath="Text" SelectedValuePath="Code"
          SelectedValue="{Binding LogWrap}"
          IsEnabled="{Binding IsEditMode}"
          ToolTip="运行日志换行方式，系统=跟随设置-应用监控的日志换行配置"/>
                        </StackPanel>
                        <!-- 预警机器人配置输入框 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Column="0" Grid.Row="1" Text="预 警:" VerticalAlignment="Top"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Column="1" Grid.Row="1"
     Text="{Binding WarnUrl, UpdateSourceTrigger=PropertyChanged}"
     IsReadOnly="{Binding IsDetailMode}"
     Height="50" TextWrapping="Wrap" AcceptsReturn="True"
     Template="{StaticResource PlaceHolder}" Tag="异常停止预警企业微信机器人URL">
                        </TextBox>
                        
                        <!-- 备注输入框 -->
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="备 注:" VerticalAlignment="Top"/>
                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="1"
     Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
     IsReadOnly="{Binding IsDetailMode}"
     Height="50" TextWrapping="Wrap" AcceptsReturn="True"
     Template="{StaticResource PlaceHolder}" Tag="备注信息，用于项目提示">
                        </TextBox>
                    </Grid>
                </GroupBox>




            </Grid>
        </ScrollViewer>
        <!-- 按钮区域 -->
        <DockPanel Margin="8 0 8 8" Grid.Row="1" LastChildFill="False">
            <!-- 提示信息 -->
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="红色必填" Foreground="Red" FontSize="11"/>
                <TextBlock Text="  " Foreground="Orange" FontSize="11"/>
                <TextBlock Text="橙色必填其一" Foreground="Orange" FontSize="11"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Info}" Content="关闭" Width="80"
                Command="{Binding CloseCommand}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Suc}" Content="保存" Width="80"
                Command="{Binding SaveCommand}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        </DockPanel>
    </Grid>

</Window>
