<Window x:Class="AppManager2.Views.AppFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppManager2.ViewModels"

        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="Auto" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Window.DataContext>
        <vm:AppFormViewModel/>
    </Window.DataContext>


    <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 基本信息区域 -->
            <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <!-- 类型 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="类型:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding AppTypes}"
                              SelectedItem="{Binding AppType}"
                              IsEnabled="{Binding IsEditMode}"
                              Margin="0,5"/>

                    <!-- 名称 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,5" Foreground="#DC3545">
                    </TextBlock>
                    <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding AppTitle, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditMode}"
                             Margin="0,5" Template="{StaticResource PlaceHolder}" Tag="项目名，最好带上端口"/>


                    <!-- 分组 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="分组:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Groups}"
                              Text="{Binding Group}"
                              IsEditable="True"
                              IsEnabled="{Binding IsEditMode}"
                              Margin="0,5"/>
                </Grid>
            </GroupBox>

            <!-- 路径配置区域 -->
            <GroupBox Grid.Row="1" Header="路径配置" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <!-- 应用路径 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="路径:" VerticalAlignment="Center" Foreground="#DC3545">
                    </TextBlock>
                    <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="0" Grid.Column="1"
                             Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}" Template="{StaticResource PlaceHolder}" Tag="jar、bat或exe的文件路径"/>

                    <Button Grid.Row="0" Grid.Column="2" Content="..."
                            Command="{Binding BrowseAppPathCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            Margin="0,5" Padding="0"/>

                    <!-- 停止脚本 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="终止:" VerticalAlignment="Center" Margin="0,5">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="stop">
                                <Binding Path="AppType"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="1" Grid.Column="1"
                             Text="{Binding StopPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Template="{StaticResource PlaceHolder}" Tag="bat类型用于终止的脚本路径">
                        
                    </TextBox>
                    <Button Grid.Row="1" Grid.Column="2" Content="..."
                            Command="{Binding BrowseStopPathCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            Margin="0,5" Padding="0"/>

                    <!-- JDK路径 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="JDK:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Style="{StaticResource FormValue_Style}" Grid.Row="2" Grid.Column="1"
                             Text="{Binding JdkPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Template="{StaticResource PlaceHolder}" Tag="jar包自定义的JDK路径"/>

                    <Button Grid.Row="2" Grid.Column="2" Content="..."
                            Command="{Binding BrowseJdkPathCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            Margin="0,5" Padding="0"/>
                </Grid>
            </GroupBox>

            <!-- 运行配置区域 -->
            <GroupBox Grid.Row="2" Header="运行配置" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <!-- 端口 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,5">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="port">
                                <Binding Path="AppType"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Margin="0,5">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FormValue_Style}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="项目端口" Foreground="LightGray" Margin="2,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 心跳地址 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="心跳:" VerticalAlignment="Center" Margin="0,5">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource AppTypeToColorConverter}" ConverterParameter="heartbeat">
                                <Binding Path="AppType"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding HeartBeatUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Margin="0,5">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FormValue_Style}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="检测项目存活返回success的URL" Foreground="LightGray" Margin="2,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Actuator -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="驱动:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding ActuatorUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Margin="0,5">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FormValue_Style}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="spring项目actuator关机路径" Foreground="LightGray" Margin="2,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </GroupBox>

            <!-- 参数配置区域 -->
            <GroupBox Grid.Row="3" Header="参数配置" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 扩展脚本 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="0" Grid.Column="0" Text="扩展:" VerticalAlignment="Top" Margin="0,5"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="常用"
                            Command="{Binding DefaultExtCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            VerticalAlignment="Top" Margin="0,5" Padding="0" FontSize="10"/>
                    <TextBox Grid.Row="0" Grid.Column="2"
                             Text="{Binding ExtScript, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,5" VerticalAlignment="Top" VerticalContentAlignment="Top" Template="{StaticResource PlaceHolder}" Tag="java启动项脚本之前的配置">
                    </TextBox>

                    <!-- JVM参数 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="1" Grid.Column="0" Text="配置:" VerticalAlignment="Top" Margin="0,5"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="常用"
                            Command="{Binding DefaultJvmCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            VerticalAlignment="Top" Margin="0,5" Padding="0" FontSize="10"/>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding JvmParams, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,5" VerticalAlignment="Top" VerticalContentAlignment="Top" Template="{StaticResource PlaceHolder}" Tag="java启动项内存等配置">
                    </TextBox>

                    <!-- 环境参数 -->
                    <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Row="2" Grid.Column="0" Text="参数:" VerticalAlignment="Top" Margin="0,5"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="常用"
                            Command="{Binding DefaultEnvCommand}"
                            IsEnabled="{Binding IsEditMode}"
                            VerticalAlignment="Top" Margin="0,5" Padding="0" FontSize="10"/>
                    <TextBox Grid.Row="2" Grid.Column="2"
                             Text="{Binding EnvParams, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsDetailMode}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,5" VerticalAlignment="Top" VerticalContentAlignment="Top" Template="{StaticResource PlaceHolder}" Tag="java启动参数日志路径环境等">
                        
                    </TextBox>
                </Grid>
            </GroupBox>

            <!-- 其他配置区域 -->
            <GroupBox Grid.Row="4" Header="其他配置" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource FormValue_Style}" Content="警报" IsChecked="{Binding IsWarn}" IsEnabled="{Binding IsEditMode}" Margin="0,5"/>
                        <CheckBox Style="{StaticResource FormValue_Style}" Content="自动启动" IsChecked="{Binding AutoRun}" IsEnabled="{Binding IsEditMode}" Margin="0,5"/>
                        <CheckBox Style="{StaticResource FormValue_Style}" Content="控制面板日志" IsChecked="{Binding IsPrintLog}" IsEnabled="{Binding IsEditMode}" Margin="0,5"/>
                    </StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Column="0" Grid.Row="0" Text="预警URL:" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" Grid.Row="0"
                                 Text="{Binding WarnUrl, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsDetailMode}"
                                 Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalAlignment="Top" VerticalContentAlignment="Top" Template="{StaticResource PlaceHolder}" Tag="异常停止预警企业微信机器人URL">
                        </TextBox>
                    </Grid>



                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FormLabel_Style}" Grid.Column="0" Text="备注:" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsDetailMode}"
                                 Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalAlignment="Top" VerticalContentAlignment="Top" Template="{StaticResource PlaceHolder}" Tag="备注信息，用于项目提示">
                        </TextBox>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 提示信息 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="红色必填" Foreground="Red" FontSize="11"/>
                <TextBlock Text="  " Foreground="Orange" FontSize="11"/>
                <TextBlock Text="橙色必填其一" Foreground="Orange" FontSize="11"/>
            </StackPanel>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource ButtonSuccess_Style}" Content="保存" Width="80"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Style="{StaticResource ButtonInfo_Style}" Content="关闭" Width="80"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
