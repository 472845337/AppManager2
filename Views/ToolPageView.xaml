<UserControl x:Class="AppManager2.Views.ToolPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:AppManager2.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500"
             Loaded="ToolPageView_Loaded">
    <UserControl.DataContext>
        <vm:ToolPageViewModel/>
    </UserControl.DataContext>

    <!-- 对应老项目PostDog页：URL行 + Head区(记忆高度) + 参数/响应分栏(记忆高度) + 底部选项 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- URL行：类型/地址/发送/保存/历史（保存/历史对应老项目SaveHttpButton/SendHistoryButton的纯图标按钮） -->
        <DockPanel Grid.Row="0">
            <ComboBox Style="{StaticResource FormValue_Style}" DockPanel.Dock="Left" Width="Auto" MinWidth="80" SelectedItem="{Binding HttpType}"
                      ItemsSource="{x:Static vm:ToolPageViewModel.HttpTypes}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Info}"
                    Command="{Binding ViewHttpHistoryCommand}" ToolTip="发送记录">
                <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/ToolForm/send_history.ico" Width="18" Height="18"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Info}"
                    Command="{Binding SaveHttpConfigCommand}" ToolTip="保存当前配置为发送记录">
                <Image Source="pack://application:,,,/AppManager2;component/Resources/icon/ToolForm/save_http.ico" Width="18" Height="18"/>
            </Button>
            <Button Style="{StaticResource Btn_Pri}" DockPanel.Dock="Right" Width="64"
                    Command="{Binding SendHttpRequestCommand}"
                    Content="{Binding SendButtonText}"/>
            <TextBox Style="{StaticResource FormValue_Style}" Text="{Binding HttpUrl, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Template="{StaticResource PlaceHolder}" Tag="请求地址，自动补http://"/>
        </DockPanel>

        <!-- 两个分隔器放在同一Grid（5行）：PreviousAndNext只重排相邻两行的空间、其余行像素高度保持不变，
             因此拖动任一分隔器都不会带动另一个分隔器位移 -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <!-- Head区占比记忆（默认40%，ini [tool] split-pct-head）；星号比例随父窗口缩放，避免固定像素溢出 -->
                <RowDefinition x:Name="HeadRow" Height="40*" MinHeight="70"/>
                <RowDefinition Height="Auto"/>
                <!-- 参数区占比记忆（默认占下方50%，ini [tool] split-pct） -->
                <RowDefinition x:Name="ParamRow" Height="30*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ResponseRow" Height="30*" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- Head参数区 -->
            <Border Grid.Row="0" BorderBrush="#ddd" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Background="#FAFAFA">
                        <TextBlock Style="{StaticResource FormLabel_Style}" Text="Head" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource FormValue_Style}" Content="100-Continue" IsChecked="{Binding Expect100Continue}" IsEnabled="{Binding IsPost}" ToolTip="仅POST可用"/>
                        <Button Style="{StaticResource Btn_Danger}" DockPanel.Dock="Right" Content="－" Command="{Binding ClearAllHeaderCommand}" ToolTip="清空所有Head参数"/>
                        <Button Style="{StaticResource Btn_Pri}" DockPanel.Dock="Right" Content="+" Command="{Binding AddHeaderCommand}" ToolTip="添加Head参数"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="5" Padding="0 0 5 5" ItemsSource="{Binding HeadParams}" BorderThickness="1" BorderBrush="#ddd">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8*" MinWidth="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" ToolTip="参数名" Template="{StaticResource PlaceHolder}" Tag="Key"/>
                                        <GridSplitter Margin="0 5 0 0" Grid.Column="1" VerticalAlignment="Stretch" Width="4" Background="#ddd" ResizeBehavior="PreviousAndNext"/>
                                        <TextBox Style="{StaticResource FormValue_Style}" Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" ToolTip="参数值" Template="{StaticResource PlaceHolder}" Tag="Value"/>
                                        <Button Grid.Column="3" Style="{StaticResource Btn_Danger}" Content="-" Command="{Binding DataContext.DeleteHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#ddd"
                          ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted" Margin="2"/>

            <!-- Form/Raw参数区 -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding ParamModeIndex}" Background="Transparent" BorderThickness="1" BorderBrush="#ddd">
                <TabItem Header="Form">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <RadioButton Style="{StaticResource FormValue_Style}" Content="form-data" GroupName="FormContentType"
                                                 IsChecked="{Binding FormIsFormData}"/>
                            <RadioButton Style="{StaticResource FormValue_Style}" Content="x-www-form-urlencoded" GroupName="FormContentType"
                                                 IsChecked="{Binding FormIsFormData, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Danger}" Content="－"
                                            Command="{Binding ClearAllParamCommand}" ToolTip="清空所有参数"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn_Pri}" Content="+"
                                            Command="{Binding AddParamCommand}" ToolTip="添加参数"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="5" Padding="0 0 5 5" ItemsSource="{Binding FormParams}" BorderBrush="#ddd" BorderThickness="1">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="2*" MinWidth="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8*" MinWidth="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Style="{StaticResource FormValue_Style}" Grid.Column="0" SelectedItem="{Binding ParamType}" ToolTip="text文本 / file文件（file时双击值选择文件）">
                                                <sys:String>text</sys:String>
                                                <sys:String>file</sys:String>
                                            </ComboBox>
                                            <TextBox Style="{StaticResource FormValue_Style}" Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalContentAlignment="Center" ToolTip="参数名" Template="{StaticResource PlaceHolder}" Tag="Key"/>
                                            <GridSplitter Grid.Column="2" VerticalAlignment="Stretch" Width="4" Background="#ddd"
                                                      ResizeBehavior="PreviousAndNext"/>
                                            <TextBox Style="{StaticResource FormValue_Style}" Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip="file类型双击选择文件" Template="{StaticResource PlaceHolder}" Tag="Value">
                                                <TextBox.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                          Command="{Binding DataContext.BrowseParamFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="4" Style="{StaticResource Btn_Danger}" Content="-"
                                                            Command="{Binding DataContext.DeleteParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Raw">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" DockPanel.Dock="Left" LastChildFill="False">
                            <TextBlock Style="{StaticResource FormLabel_Style}" Text="类型:"/>
                            <ComboBox Style="{StaticResource FormValue_Style}" Width="110" SelectedItem="{Binding RawType}"
                                    ItemsSource="{x:Static vm:ToolPageViewModel.RawTypes}"/>
                        </DockPanel>
                        <TextBox Margin="5" Padding="5" Grid.Row="1" Text="{Binding RawBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="15"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#ddd"
                          ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted" Margin="2"/>

            <!-- 响应区 -->
            <DockPanel Grid.Row="4">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Background="#FAFAFA">
                    <TextBlock Style="{StaticResource FormLabel_Style}" Text="响应" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Margin="0 2 0 2" Style="{StaticResource Btn_Danger}" Content="清空"
                            Command="{Binding ClearResponseCommand}"/>
                </DockPanel>
                <TextBox Text="{Binding HttpResponse, Mode=OneWay}" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Background="Black" Foreground="White"/>
            </DockPanel>
        </Grid>

        <!-- 底部选项：超时 + 自动记录请求 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Cursor="">
            <CheckBox Style="{StaticResource FormValue_Style}" Content="超时" IsChecked="{Binding IsTimeoutEnabled}" VerticalAlignment="Center"
                      Checked="TimeoutSetting_Changed" Unchecked="TimeoutSetting_Changed"/>
            <TextBox Style="{StaticResource FormValue_Style}" Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" Width="50"
                     VerticalContentAlignment="Center" LostFocus="TimeoutSetting_Changed"/>
            <TextBlock Style="{StaticResource FormLabel_Style}" Text="秒" VerticalAlignment="Center"/>
            <CheckBox Style="{StaticResource FormValue_Style}" Content="记录请求配置" IsChecked="{Binding SaveHttpRequest}" VerticalAlignment="Center"
                      ToolTip="发送的请求自动保存到发送记录"
                      Checked="SaveHttpRequest_Changed" Unchecked="SaveHttpRequest_Changed"/>
        </StackPanel>
    </Grid>
</UserControl>
